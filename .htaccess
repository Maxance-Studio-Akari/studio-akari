# Studio Akari — configuration Apache pour l'hébergement OVHcloud
# Ce fichier doit être envoyé avec le site (c'est un fichier caché : vérifiez qu'il est bien présent sur le serveur).

AddDefaultCharset utf-8
Options -Indexes

# ---------- Redirections : https://studio-akari.fr comme adresse unique ----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http:// → https:// (méthode recommandée par OVHcloud)
  RewriteCond %{SERVER_PORT} ^80$
  RewriteRule ^(.*)$ https://studio-akari.fr/$1 [R=301,L]

  # www.studio-akari.fr → studio-akari.fr
  RewriteCond %{HTTP_HOST} ^www\.studio-akari\.fr$ [NC]
  RewriteRule ^(.*)$ https://studio-akari.fr/$1 [R=301,L]
</IfModule>

# ---------- Page d'erreur ----------
ErrorDocument 404 /404.html

# ---------- Types de fichiers ----------
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest
AddType image/x-icon .ico

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

# ---------- Mise en cache dans le navigateur ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
</IfModule>

# ---------- En-têtes de sécurité ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # À activer une fois le certificat HTTPS confirmé et le site vérifié en https (impose le https aux navigateurs pendant 1 an) :
  # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
